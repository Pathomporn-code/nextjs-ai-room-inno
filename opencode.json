{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@dietrichgebert/ponytail"] ,
  "autoupdate": true,
  "formatter": true,
  "lsp": true,
  "permission": {
    "bash":{
      "git add *" : "ask",
      "git commit -m *" : "ask",
      "git push" : "ask",
      "rm *" : "ask",
      "rmdir *" : "ask",
      "external_directory": "ask"
    }
  }
}
